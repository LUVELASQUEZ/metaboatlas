{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luvelasquez.github.io/metaboatlas/schema/fuentes.schema.json",
  "title": "Registro de fuentes",
  "description": "Estructura de sources.yaml (secciones 2 y 11 de docs/MANUAL.md). Una fuente solo se puede usar si está verificada.",
  "type": "object",
  "propertyNames": { "$ref": "comun.schema.json#/$defs/id_fuente" },
  "additionalProperties": { "$ref": "#/$defs/fuente" },
  "minProperties": 1,
  "$defs": {
    "fuente": {
      "type": "object",
      "properties": {
        "nombre": { "type": "string", "minLength": 1 },
        "uso": { "enum": ["redistribuir", "por_verificar", "solo_enlace"] },
        "estado": { "enum": ["pendiente de verificar", "verificada"] },
        "url": { "type": ["string", "null"], "pattern": "^https://" },
        "licencia": { "type": ["string", "null"], "minLength": 1 },
        "licencia_url": { "type": ["string", "null"], "pattern": "^https://" },
        "verificada": {
          "oneOf": [{ "$ref": "comun.schema.json#/$defs/fecha" }, { "type": "null" }]
        },
        "que_tomamos": { "type": ["string", "null"] },
        "condicion": { "type": ["string", "null"] },
        "acceso": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "plantillas": {
          "type": "object",
          "propertyNames": { "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$" },
          "additionalProperties": { "type": "string", "pattern": "^https://.*\\{id\\}" }
        },
        "cita_recomendada": { "type": ["string", "null"] },
        "doi_cita": { "type": ["string", "null"], "pattern": "^10\\.[0-9]{4,}/" },
        "notas": { "type": ["string", "null"] },
        "sin_cita_oficial": {
          "description": "true si la base no publica una cita recomendada; entonces la cita queda en null y `notas` explica dónde se buscó.",
          "type": "boolean"
        }
      },
      "required": [
        "nombre",
        "uso",
        "estado",
        "url",
        "licencia",
        "licencia_url",
        "verificada",
        "que_tomamos",
        "condicion",
        "acceso",
        "plantillas",
        "cita_recomendada",
        "doi_cita",
        "notas"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "description": "Una fuente verificada debe tener licencia, URL de licencia y fecha de verificación.",
          "if": { "properties": { "estado": { "const": "verificada" } } },
          "then": {
            "properties": {
              "licencia": { "type": "string" },
              "licencia_url": { "type": "string" },
              "verificada": { "type": "string" }
            }
          }
        },
        {
          "description": "Una fuente que se redistribuye y está verificada debe tener su cita recomendada.",
          "if": {
            "properties": {
              "estado": { "const": "verificada" },
              "uso": { "const": "redistribuir" },
              "sin_cita_oficial": { "const": false }
            }
          },
          "then": {
            "properties": { "cita_recomendada": { "type": "string", "minLength": 1 } }
          }
        },
        {
          "description": "Sin cita oficial no se escribe ninguna (regla 6) y las notas explican dónde se buscó.",
          "if": {
            "properties": { "sin_cita_oficial": { "const": true } },
            "required": ["sin_cita_oficial"]
          },
          "then": {
            "properties": {
              "cita_recomendada": { "type": "null" },
              "doi_cita": { "type": "null" },
              "notas": { "type": "string", "minLength": 1 }
            }
          }
        },
        {
          "description": "Una fuente solo de enlace no aporta datos ni accesos de descarga.",
          "if": { "properties": { "uso": { "const": "solo_enlace" } } },
          "then": {
            "properties": {
              "que_tomamos": { "const": "nada" },
              "acceso": { "type": "array", "maxItems": 0 }
            }
          }
        }
      ]
    }
  }
}
