{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luvelasquez.github.io/metaboatlas/schema/cobertura.schema.json",
  "title": "Cobertura",
  "description": "Cobertura de una vía en un organismo, con el estado de evidencia de cada paso. Archivo cobertura/<slug>/<taxon>.json del paquete de datos (sección 5 de docs/MANUAL.md). 'Sin anotación' no significa 'ausente'.",
  "type": "object",
  "properties": {
    "via": { "$ref": "comun.schema.json#/$defs/id_via" },
    "taxon": { "$ref": "comun.schema.json#/$defs/curie_taxon" },
    "cobertura": {
      "description": "Porcentaje de pasos presentes o espontáneos.",
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "clase": {
      "enum": ["completa", "casi_completa", "parcial", "no_detectada"]
    },
    "pasos": {
      "description": "Estado de cada paso, por ID local del paso.",
      "type": "object",
      "propertyNames": { "$ref": "comun.schema.json#/$defs/id_paso" },
      "additionalProperties": { "$ref": "#/$defs/estado_paso" },
      "minProperties": 1
    },
    "modo": {
      "description": "precalculado en el pipeline o calculado en vivo en el navegador.",
      "enum": ["precalculado", "en_vivo"],
      "default": "precalculado"
    },
    "calculado": { "$ref": "comun.schema.json#/$defs/fecha" },
    "fuentes": { "$ref": "comun.schema.json#/$defs/versiones_fuentes" }
  },
  "required": ["via", "taxon", "cobertura", "clase", "pasos", "calculado", "fuentes"],
  "additionalProperties": false,
  "$defs": {
    "estado_paso": {
      "type": "object",
      "properties": {
        "estado": { "$ref": "comun.schema.json#/$defs/estado_evidencia" },
        "proteinas": {
          "description": "Proteínas del organismo que respaldan el estado.",
          "type": "array",
          "items": { "$ref": "comun.schema.json#/$defs/curie_uniprot" },
          "uniqueItems": true
        },
        "advertencias": {
          "type": "array",
          "items": { "enum": ["complejo_verificar_subunidades"] },
          "uniqueItems": true
        }
      },
      "required": ["estado", "proteinas"],
      "additionalProperties": false,
      "if": {
        "properties": { "estado": { "enum": ["alta", "media", "baja"] } }
      },
      "then": {
        "description": "Un paso con evidencia debe citar al menos una proteína.",
        "properties": { "proteinas": { "type": "array", "minItems": 1 } }
      },
      "else": {
        "description": "Un paso espontáneo o sin anotación no cita proteínas.",
        "properties": { "proteinas": { "type": "array", "maxItems": 0 } }
      }
    }
  }
}
